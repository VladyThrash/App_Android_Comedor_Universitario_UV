<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_pantalla">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UvPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mis Pedidos" />

                <TextView
                    android:id="@+id/tvHistorialSubtitulo"
                    style="@style/UvPageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="6 pedidos registrados" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevoPedidoHistorial"
                style="@style/UvButtonPrimario"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="16dp"
                android:text="+ Nuevo pedido"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Alerta dinámica (calificado / cancelado / error) -->
        <TextView
            android:id="@+id/tvHistorialAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_alert_exito"
            android:padding="12dp"
            android:textColor="@color/uv_verde_dark"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/layoutHistorialVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="56dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Aún no tienes pedidos"
                android:textColor="@color/uv_gris_900"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="Explora el menú y haz tu primer pedido"
                android:textColor="@color/uv_gris_500"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMenuDesdeHistorial"
                style="@style/UvButtonPrimario"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingHorizontal="24dp"
                android:text="Ver el menú" />
        </LinearLayout>

        <!-- Lista de tarjetas de pedidos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidosHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>