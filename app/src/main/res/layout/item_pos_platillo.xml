<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPosPlatilloItem"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="116dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPosItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/uv_gris_900"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Mole Poblano con Arroz" />

        <TextView
            android:id="@+id/tvPosItemCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/uv_gris_500"
            android:textSize="11sp"
            tools:text="Menú del Día" />

        <TextView
            android:id="@+id/tvPosItemEstadoStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/uv_rojo"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Quedan 4"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPosItemPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/uv_azul"
            android:textSize="16sp"
            tools:text="$35.00" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>