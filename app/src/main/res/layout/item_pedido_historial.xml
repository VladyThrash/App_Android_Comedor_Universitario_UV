<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera de la tarjeta: Folio, badges, fecha y total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvItemPedidoFolio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/uv_azul"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="UV-2026-0042" />

                    <TextView
                        android:id="@+id/tvItemPedidoEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_shape"
                        android:backgroundTint="@color/uv_amarillo_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/uv_amarillo_texto"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="PENDIENTE" />

                    <TextView
                        android:id="@+id/tvItemPedidoBadgeAnticipado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_shape"
                        android:backgroundTint="@color/uv_amarillo_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="Anticipado"
                        android:textColor="@color/uv_amarillo_texto"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvItemPedidoFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="12sp"
                    tools:text="27/11/2026 13:15" />

                <TextView
                    android:id="@+id/tvItemPedidoRecogida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_gris_700"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Recoger: 28/11/2026 14:00"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Columna derecha: Total y ahorro por beca -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemPedidoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/uv_gris_900"
                    android:textSize="17sp"
                    tools:text="$35.00" />

                <TextView
                    android:id="@+id/tvItemPedidoDescuentoBeca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_verde"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Beca: -$35.00"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_borde" />

        <!-- Resumen de platillos incluidos en el pedido -->
        <TextView
            android:id="@+id/tvItemPedidoResumenPlatillos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/uv_gris_900"
            android:textSize="13sp"
            tools:text="1x Chilaquiles Verdes [Beca] — Gratis\n1x Agua de Horchata 500ml — $18.00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/uv_gris_200" />

        <!-- Barra de acciones del pedido -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemPedidoDetalle"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Ver detalle"
                    android:textAllCaps="false"
                    android:textColor="@color/uv_gris_700"
                    android:textSize="12sp"
                    app:backgroundTint="@color/uv_gris_200"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemPedidoPdf"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Descargar PDF"
                    android:textAllCaps="false"
                    android:textColor="@color/uv_gris_700"
                    android:textSize="12sp"
                    app:backgroundTint="@color/uv_gris_200"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemPedidoCalificar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:text="Calificar"
                    android:textAllCaps="false"
                    android:textColor="@color/uv_amarillo_texto"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/uv_amarillo_light"
                    app:cornerRadius="8dp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvItemPedidoYaCalificado"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_shape"
                    android:backgroundTint="@color/uv_verde_light"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Calificado"
                    android:textColor="@color/uv_verde_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemPedidoCancelar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="@color/uv_rojo"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/uv_gris_200"
                    app:cornerRadius="8dp"
                    tools:visibility="visible" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>