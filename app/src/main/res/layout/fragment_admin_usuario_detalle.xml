<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_pantalla">

        <LinearLayout
            android:id="@+id/btnVolverAUsuarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Volver a usuarios"
                android:textColor="@color/uv_gris_500"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cabecera con Avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUsuarioDetIniciales"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_avatar_perfil"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/uv_blanco"
                android:textSize="24sp"
                tools:text="VY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUsuarioDetNombre"
                    style="@style/UvPageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    tools:text="Vladimir Yepez Contreras" />

                <TextView
                    android:id="@+id/tvUsuarioDetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="13sp"
                    tools:text="zs22000000@estudiantes.uv.mx" />

                <TextView
                    android:id="@+id/tvUsuarioDetRolBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_shape"
                    android:backgroundTint="@color/uv_azul_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/uv_azul"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="ESTUDIANTE" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta Información -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <TextView
                    style="@style/UvCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Información" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_item_suave"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Teléfono"
                        android:textColor="@color/uv_gris_700"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUsuarioDetTelefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uv_gris_900"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2291234567" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_item_suave"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fecha de registro"
                        android:textColor="@color/uv_gris_700"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUsuarioDetFechaRegistro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uv_gris_900"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="2026-08-14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_suave"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Estado"
                        android:textColor="@color/uv_gris_700"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUsuarioDetEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uv_verde"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Activa" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>