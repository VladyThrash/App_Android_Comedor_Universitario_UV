<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMovItemTipoPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_shape"
                android:backgroundTint="@color/uv_verde_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/uv_verde_dark"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="ENTRADA" />

            <TextView
                android:id="@+id/tvMovItemFecha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/uv_gris_500"
                android:textSize="12sp"
                tools:text="27/11/2026 11:20" />

            <TextView
                android:id="@+id/tvMovItemCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/uv_verde"
                android:textSize="15sp"
                tools:text="+10.00" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMovItemIngrediente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/uv_gris_900"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Ingrediente #4 — Pechuga de Pollo" />

        <TextView
            android:id="@+id/tvMovItemStockResultante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/uv_gris_700"
            android:textSize="12sp"
            tools:text="Stock resultante: 22.50" />

        <TextView
            android:id="@+id/tvMovItemMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/uv_gris_500"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="Compra semanal proveedor local" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>