<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_item_suave"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivItemCarritoImagen"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@color/uv_gris_200"
        android:contentDescription="Miniatura de platillo"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemCarritoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/uv_gris_900"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Enchiladas Suizas" />

        <TextView
            android:id="@+id/tvItemCarritoPersonalizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/uv_gris_500"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Sin cebolla, extra crema"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvItemCarritoPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/uv_azul"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="$40.00" />

        <!-- Controles de cantidad (.cantidad-control) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnItemCarritoMenos"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo_badge"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/uv_gris_900"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemCarritoCantidad"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/uv_gris_900"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2" />

            <TextView
                android:id="@+id/btnItemCarritoMas"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo_badge"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/uv_gris_900"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnItemCarritoEliminar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Eliminar platillo"
        android:src="@drawable/ic_delete" />
</LinearLayout>