<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uv_blanco"
    android:fillViewport="true"
    tools:context=".ui.auth.RegistroActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera institucional compacta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_uv_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="22dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_logo_badge"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="UV"
                android:textColor="@color/uv_azul"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Comedor Universitario"
                    android:textColor="@color/uv_blanco"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="Crea tu cuenta universitaria"
                    android:textColor="@color/uv_blanco"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Formulario de registro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/UvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear cuenta" />

            <TextView
                style="@style/UvPageSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Solo se aceptan correos @uv.mx o @estudiantes.uv.mx" />

            <!-- Alertas -->
            <TextView
                android:id="@+id/tvRegistroError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_alert_error"
                android:padding="12dp"
                android:textColor="@color/uv_rojo_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRegistroExito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_alert_exito"
                android:padding="12dp"
                android:textColor="@color/uv_verde_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Nombre(s) -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Nombre(s)" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tu nombre"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Apellidos -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Apellidos" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApellidos"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tus apellidos"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Correo institucional UV -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Correo institucional UV" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmailRegistro"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmailRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="matricula@estudiantes.uv.mx"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Teléfono (opcional) -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Teléfono (opcional)" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTelefono"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:hint="10 dígitos"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Contraseña" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPasswordRegistro"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mínimo 8 caracteres"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Indicador de fuerza de contraseña (.password-strength) -->
            <LinearLayout
                android:id="@+id/layoutPasswordStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/progressPasswordStrength"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="100"
                    android:progress="60"
                    android:progressTint="@color/uv_amarillo" />

                <TextView
                    android:id="@+id/tvPasswordStrengthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_amarillo_texto"
                    android:textSize="11sp"
                    tools:text="Regular" />
            </LinearLayout>

            <!-- Confirmar contraseña -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="Confirmar contraseña" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmarPassword"
                style="@style/UvTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:endIconMode="password_toggle"
                app:errorEnabled="true"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmarPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Repite tu contraseña"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Selector de Rol (.roles-grid) -->
            <TextView
                style="@style/UvFormLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="¿Quién eres?" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@id/btnRolEstudiante"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRolEstudiante"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Estudiante"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/uv_azul" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRolBecado"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Becado"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/uv_verde" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRolDocente"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Docente"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/uv_azul" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- BLOQUE 1: Campos ESTUDIANTE -->
            <LinearLayout
                android:id="@+id/containerCamposEstudiante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campos_rol"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="visible">

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Matrícula" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMatricula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="zS12345678"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Semestre" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSemestreEstudiante"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:boxBackgroundColor="@color/uv_blanco"
                    app:boxCornerRadiusBottomEnd="@dimen/radio"
                    app:boxCornerRadiusBottomStart="@dimen/radio"
                    app:boxCornerRadiusTopEnd="@dimen/radio"
                    app:boxCornerRadiusTopStart="@dimen/radio">

                    <AutoCompleteTextView
                        android:id="@+id/actvSemestreEstudiante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="1° semestre"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Carrera" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCarreraEstudiante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingeniería en Informática"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- BLOQUE 2: Campos BECADO -->
            <LinearLayout
                android:id="@+id/containerCamposBecado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campos_rol"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_alert_exito"
                    android:padding="12dp"
                    android:text="Beca alimentaria - Tu correo debe estar en la lista de becados autorizados por la universidad. Si tu beca está aprobada pero tu correo no aparece, contacta a la administración del comedor."
                    android:textColor="@color/uv_verde_dark"
                    android:textSize="12sp" />

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Carrera" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCarreraBecado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingeniería en Sistemas Computacionales"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Semestre" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSemestreBecado"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/uv_blanco"
                    app:boxCornerRadiusBottomEnd="@dimen/radio"
                    app:boxCornerRadiusBottomStart="@dimen/radio"
                    app:boxCornerRadiusTopEnd="@dimen/radio"
                    app:boxCornerRadiusTopStart="@dimen/radio">

                    <AutoCompleteTextView
                        android:id="@+id/actvSemestreBecado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="1° semestre"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- BLOQUE 3: Campos DOCENTE -->
            <LinearLayout
                android:id="@+id/containerCamposDocente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campos_rol"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Número empleado" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNumEmpleadoDocente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="DOC-0042"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Facultad" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFacultad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingeniería"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Departamento" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/UvTextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDepartamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sistemas"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/UvFormLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Categoría" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCategoriaDocente"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/uv_blanco"
                    app:boxCornerRadiusBottomEnd="@dimen/radio"
                    app:boxCornerRadiusBottomStart="@dimen/radio"
                    app:boxCornerRadiusTopEnd="@dimen/radio"
                    app:boxCornerRadiusTopStart="@dimen/radio">

                    <AutoCompleteTextView
                        android:id="@+id/actvCategoriaDocente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="Profesor de Tiempo Completo"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Aceptación de términos -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbTerminos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Acepto que mis datos sean utilizados para la gestión de pedidos del Comedor UV."
                android:textColor="@color/uv_gris_700"
                android:textSize="13sp"
                app:buttonTint="@color/uv_azul" />

            <!-- Botón Crear cuenta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                style="@style/UvButtonPrimario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Crear mi cuenta"
                android:textSize="15sp" />

            <!-- Enlace a Login -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? "
                    android:textColor="@color/uv_gris_500"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvIrLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="Inicia sesión aquí"
                    android:textColor="@color/uv_azul"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>