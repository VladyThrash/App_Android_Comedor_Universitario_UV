<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIngItemNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/uv_gris_900"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Tomate Saladette" />

                <TextView
                    android:id="@+id/tvIngItemDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Caja de 20 kg primera calidad"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvIngItemEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_shape"
                android:backgroundTint="@color/uv_verde_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="OK"
                android:textColor="@color/uv_verde_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIngItemStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/uv_verde"
                    android:textSize="14sp"
                    tools:text="Stock: 14.5 kg (mín: 5.0)" />

                <TextView
                    android:id="@+id/tvIngItemMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="12sp"
                    tools:text="$24.50 / kg · Verduras" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngItemMovimiento"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Movimiento"
                android:textAllCaps="false"
                android:textColor="@color/uv_azul"
                android:textSize="12sp"
                app:backgroundTint="@color/uv_azul_light"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>