<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_pantalla">

        <TextView
            style="@style/UvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Programar Menú Semanal" />

        <TextView
            style="@style/UvPageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Asigna platillos por día y categoría con su cupo (cantidad de porciones disponibles)." />

        <TextView
            android:id="@+id/tvMenuSemanalError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_alert_error"
            android:padding="12dp"
            android:textColor="@color/uv_rojo_dark"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Pestañas de Días (.dia-tabs) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutMenuSemanalDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@color/uv_blanco"
            app:tabIndicatorColor="@color/uv_azul"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="@color/uv_azul"
            app:tabTextColor="@color/uv_gris_700">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunes" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Martes" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Miércoles" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jueves" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viernes" />
        </com.google.android.material.tabs.TabLayout>

        <!-- TARJETA 1: DESAYUNO -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSemanalDesayunoTitulo"
                        style="@style/UvCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/uv_azul"
                        tools:text="Desayuno — Lunes" />

                    <TextView
                        android:id="@+id/tvSemanalDesayunoCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uv_gris_500"
                        android:textSize="12sp"
                        tools:text="2 platillos" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/color_borde" />

                <TextView
                    android:id="@+id/tvSemanalDesayunoVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_suave"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No hay platillos asignados a desayuno"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSemanalDesayuno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Formulario agregar a Desayuno -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:boxBackgroundColor="@color/uv_blanco"
                        app:boxCornerRadiusBottomEnd="@dimen/radio"
                        app:boxCornerRadiusBottomStart="@dimen/radio"
                        app:boxCornerRadiusTopEnd="@dimen/radio"
                        app:boxCornerRadiusTopStart="@dimen/radio">

                        <AutoCompleteTextView
                            android:id="@+id/actvSemanalDesayunoPlatillo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Selecciona un platillo..."
                            android:inputType="none"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/UvTextInputLayout"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:hint="Cupo">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSemanalDesayunoCupo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="50"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSemanalAgregarDesayuno"
                            style="@style/UvButtonPrimario"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="+ Agregar a desayuno"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA 2: COMIDA -->
        <com.google.android.material.card.MaterialCardView
            style="@style/UvCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSemanalComidaTitulo"
                        style="@style/UvCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/uv_azul"
                        tools:text="Comida — Lunes" />

                    <TextView
                        android:id="@+id/tvSemanalComidaCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/uv_gris_500"
                        android:textSize="12sp"
                        tools:text="3 platillos" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/color_borde" />

                <TextView
                    android:id="@+id/tvSemanalComidaVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_suave"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="No hay platillos asignados a comida"
                    android:textColor="@color/uv_gris_500"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSemanalComida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Formulario agregar a Comida -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:boxBackgroundColor="@color/uv_blanco"
                        app:boxCornerRadiusBottomEnd="@dimen/radio"
                        app:boxCornerRadiusBottomStart="@dimen/radio"
                        app:boxCornerRadiusTopEnd="@dimen/radio"
                        app:boxCornerRadiusTopStart="@dimen/radio">

                        <AutoCompleteTextView
                            android:id="@+id/actvSemanalComidaPlatillo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Selecciona un platillo..."
                            android:inputType="none"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/UvTextInputLayout"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:hint="Cupo">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSemanalComidaCupo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="50"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSemanalAgregarComida"
                            style="@style/UvButtonPrimario"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="+ Agregar a comida"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alert_info"
            android:padding="14dp"
            android:text="Cómo funciona el cupo: cada vez que se vende este platillo (online o en POS), el sistema descuenta del cupo. Cuando se agota, los clientes lo verán como AGOTADO y no podrán pedirlo."
            android:textColor="@color/uv_azul_dark"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>