<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenedor principal -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_fondo">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/uv_azul"
            app:elevation="4dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarMain"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/uv_azul"
                app:navigationIconTint="@color/uv_blanco"
                app:title="Comedor UV"
                app:titleTextColor="@color/uv_blanco">

                <!-- Acciones derechas: Notificaciones y Carrito -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <!-- Campanita de notificaciones -->
                    <FrameLayout
                        android:id="@+id/btnToolbarNotificaciones"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Notificaciones"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Notificaciones"
                            android:src="@drawable/ic_notifications"
                            app:tint="@color/uv_blanco" />

                        <TextView
                            android:id="@+id/tvNotifBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_circle_shape"
                            android:backgroundTint="@color/uv_rojo"
                            android:gravity="center"
                            android:textColor="@color/uv_blanco"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="3"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <!-- Carrito de compras -->
                    <FrameLayout
                        android:id="@+id/btnToolbarCarrito"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Carrito de pedido"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Carrito"
                            android:src="@drawable/ic_shopping_cart"
                            app:tint="@color/uv_blanco" />

                        <TextView
                            android:id="@+id/tvCarritoBadge"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_circle_shape"
                            android:backgroundTint="@color/uv_amarillo"
                            android:gravity="center"
                            android:textColor="@color/uv_azul"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="2"
                            tools:visibility="visible" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Host de fragmentos -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHostFragmentMain"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:navGraph="@navigation/nav_graph" />

        <!-- Botón flotante de asistencia por voz (accesibilidad.js) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAccesibilidadVoz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Leer pantalla en voz alta"
            app:backgroundTint="@color/uv_azul"
            app:srcCompat="@drawable/ic_volume_up"
            app:tint="@color/uv_blanco" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Menú lateral por roles -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navViewMain"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/uv_blanco"
        app:headerLayout="@layout/nav_header_main"
        app:itemIconTint="@color/uv_azul"
        app:itemTextColor="@color/uv_gris_900"
        app:menu="@menu/menu_nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>