<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/uv_blanco"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/UvCardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar movimiento"
        android:textColor="@color/uv_azul"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvMovModalIngredienteNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/uv_gris_500"
        android:textSize="13sp"
        tools:text="Tomate Saladette" />

    <TextView
        style="@style/UvFormLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Tipo de movimiento *" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundColor="@color/uv_blanco"
        app:boxCornerRadiusBottomEnd="@dimen/radio"
        app:boxCornerRadiusBottomStart="@dimen/radio"
        app:boxCornerRadiusTopEnd="@dimen/radio"
        app:boxCornerRadiusTopStart="@dimen/radio">

        <AutoCompleteTextView
            android:id="@+id/actvMovModalTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:text="Entrada (sumar stock)"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/UvTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.5"
            android:hint="Cantidad *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMovModalCantidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/UvTextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:boxBackgroundColor="@color/uv_gris_100"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMovModalUnidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:textColor="@color/uv_gris_700"
                android:textSize="14sp"
                tools:text="kg" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        style="@style/UvFormLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Motivo / Notas" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/UvTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMovModalMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="Ej: Compra al proveedor, Caducidad, Uso en cocina..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarMovModal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/uv_gris_700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarMovModal"
            style="@style/UvButtonPrimario"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.6"
            android:text="Registrar movimiento" />
    </LinearLayout>
</LinearLayout>