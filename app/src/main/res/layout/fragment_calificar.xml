<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_pantalla">

        <!-- Enlace volver al pedido -->
        <LinearLayout
            android:id="@+id/btnVolverPedidoCalificar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Volver al pedido"
                android:textColor="@color/uv_gris_500"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Encabezado -->
        <TextView
            style="@style/UvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Califica tu pedido" />

        <TextView
            android:id="@+id/tvCalificarSubtitulo"
            style="@style/UvPageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            tools:text="Pedido UV-2026-0042 — Cuéntanos qué te pareció cada platillo" />

        <!-- Alerta cuando no hay platillos válidos -->
        <TextView
            android:id="@+id/tvCalificarSinPlatillos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_alert_error"
            android:padding="14dp"
            android:text="No se encontraron platillos válidos en este pedido para calificar."
            android:textColor="@color/uv_rojo_dark"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Lista de platillos a evaluar -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCalificarPlatillos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Botones Enviar / Cancelar -->
        <LinearLayout
            android:id="@+id/layoutCalificarAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarResenas"
                style="@style/UvButtonPrimario"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="Enviar reseñas"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarCalificar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:paddingHorizontal="18dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/uv_gris_700"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>