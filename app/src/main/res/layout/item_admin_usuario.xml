<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvUsuarioItemIniciales"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_perfil"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:textColor="@color/uv_blanco"
            android:textSize="14sp"
            tools:text="VY" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUsuarioItemNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/uv_gris_900"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Vladimir Yepez Contreras" />

            <TextView
                android:id="@+id/tvUsuarioItemEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/uv_gris_500"
                android:textSize="12sp"
                tools:text="zs22000000@estudiantes.uv.mx" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUsuarioItemRolBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_shape"
                    android:backgroundTint="@color/uv_azul_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/uv_azul"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="ESTUDIANTE" />

                <TextView
                    android:id="@+id/tvUsuarioItemEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/uv_verde"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Activo" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsuarioItemDetalle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Detalle"
            android:textAllCaps="false"
            android:textColor="@color/uv_gris_700"
            android:textSize="12sp"
            app:backgroundTint="@color/uv_gris_200"
            app:cornerRadius="8dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>