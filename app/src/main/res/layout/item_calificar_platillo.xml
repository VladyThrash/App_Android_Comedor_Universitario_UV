<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/UvCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvItemCalifNombre"
            style="@style/UvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/uv_azul"
            android:textSize="17sp"
            tools:text="Chilaquiles Verdes con Pollo" />

        <TextView
            android:id="@+id/tvItemCalifDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/uv_gris_500"
            android:textSize="13sp"
            tools:text="Totopos bañados en salsa verde de tomatillo con crema y queso." />

        <TextView
            style="@style/UvFormLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="¿Cómo te pareció?" />

        <RatingBar
            android:id="@+id/ratingBarPlatillo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:progressBackgroundTint="@color/uv_gris_300"
            android:progressTint="@color/uv_amarillo"
            android:rating="5"
            android:secondaryProgressTint="@color/uv_amarillo"
            android:stepSize="1.0" />

        <TextView
            style="@style/UvFormLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Comentario (opcional)" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/UvTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:counterEnabled="true"
            app:counterMaxLength="500"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemCalifComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Cuéntanos más sobre tu experiencia..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="2"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>