<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_pantalla">

            <TextView
                style="@style/UvPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Punto de Venta" />

            <TextView
                android:id="@+id/tvPosCajeroSubtitulo"
                style="@style/UvPageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                tools:text="Atendido por Vladimir Yepez Contreras" />

            <!-- Alerta de error -->
            <TextView
                android:id="@+id/tvPosAlertaError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_alert_error"
                android:padding="12dp"
                android:textColor="@color/uv_rojo_dark"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Pestañas Menú del Día / A la Carta (.pos-tabs) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutPosCatalogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@color/uv_blanco"
                app:tabIndicatorColor="@color/uv_azul"
                app:tabIndicatorHeight="3dp"
                app:tabSelectedTextColor="@color/uv_azul"
                app:tabTextColor="@color/uv_gris_700">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menú del Día" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A la Carta" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Buscador y categorías (visible en tab A la Carta) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPosBuscador"
                style="@style/UvCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/UvTextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="clear_text"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_search">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPosBuscarPlatillo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Buscar platillo..."
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupPosCategorias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPosTodas"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Todas" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid de platillos (GridLayoutManager spanCount=2) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPosPlatillos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Estado vacío -->
            <TextView
                android:id="@+id/tvPosSinResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="36dp"
                android:text="No hay platillos disponibles en esta sección."
                android:textColor="@color/uv_gris_500"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior persistente de Venta Actual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPosBarraVentaActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/uv_azul"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPosBarraResumenArticulos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:text="Venta actual · 0 artículos"
                    android:textColor="@color/uv_blanco"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPosBarraTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="$0.00"
                    android:textColor="@color/uv_blanco"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAbrirVentaActualPos"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ver venta"
                android:textAllCaps="false"
                android:textColor="@color/uv_azul"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/uv_amarillo"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>