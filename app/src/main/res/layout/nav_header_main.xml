<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_uv_header_gradient"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="36dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvNavIniciales"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_shape"
        android:backgroundTint="@color/uv_verde"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="@color/uv_blanco"
        android:textSize="17sp"
        tools:text="VY" />

    <TextView
        android:id="@+id/tvNavNombreUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/uv_blanco"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Vladimir Yepez Contreras" />

    <TextView
        android:id="@+id/tvNavEmailUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.85"
        android:textColor="@color/uv_blanco"
        android:textSize="12sp"
        tools:text="zs22000000@estudiantes.uv.mx" />

    <TextView
        android:id="@+id/tvNavRolUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_shape"
        android:backgroundTint="@color/uv_azul_light"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/uv_azul_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="ESTUDIANTE" />
</LinearLayout>