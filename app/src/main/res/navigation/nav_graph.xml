<?xml version="1.0" encoding="utf-8"?>
<!-- Los id de los 4 destinos de la barra inferior deben coincidir con menu_bottom_nav.xml -->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.comedor_universitario_uv.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.comedor_universitario_uv.ui.RegistroFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <fragment
        android:id="@+id/menuFragment"
        android:name="com.example.comedor_universitario_uv.ui.MenuFragment"
        android:label="Menú"
        tools:layout="@layout/fragment_menu" />

    <fragment
        android:id="@+id/detallePlatilloFragment"
        android:name="com.example.comedor_universitario_uv.ui.DetallePlatilloFragment"
        android:label="Detalle de platillo"
        tools:layout="@layout/fragment_detalle_platillo" />

    <fragment
        android:id="@+id/carritoFragment"
        android:name="com.example.comedor_universitario_uv.ui.CarritoFragment"
        android:label="Carrito"
        tools:layout="@layout/fragment_carrito" />

    <fragment
        android:id="@+id/comprobanteFragment"
        android:name="com.example.comedor_universitario_uv.ui.ComprobanteFragment"
        android:label="Comprobante"
        tools:layout="@layout/fragment_comprobante" />

    <fragment
        android:id="@+id/pedidosFragment"
        android:name="com.example.comedor_universitario_uv.ui.PedidosFragment"
        android:label="Pedidos"
        tools:layout="@layout/fragment_pedidos" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.comedor_universitario_uv.ui.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" />
</navigation>
